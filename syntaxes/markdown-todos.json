{
  "scopeName": "markdown-todos.checkbox",
  "injectionSelector": "L:text.html.markdown - markup.fenced_code.block.markdown",
  "patterns": [
    {
      "match": "^\\s*[-*+]\\s+(\\[(?:x|X)\\])(?=\\s|$)",
      "captures": {
        "1": {
          "name": "markup.taskList.checked.markdown"
        }
      }
    },
    {
      "match": "^\\s*[-*+]\\s+(\\[ \\])(?=\\s|$)",
      "captures": {
        "1": {
          "name": "markup.taskList.unchecked.markdown"
        }
      }
    },
    {
      "match": "<[^<>\\r\\n]+>",
      "name": "markup.underline.link.markdown"
    }
  ]
}
