{
  "name": "markdown-todos",
  "displayName": "markdown-todos",
  "description": "Collects to-do items in MarkDown files to an Explorer tree view with contextual menues for toggling and removing to-do items and keeps the tree view up-to-date as to-do items are inserted, updated and deleted in any MarkDown file in the workspace.",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.md",
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "grammars": [
      {
        "path": "./syntaxes/markdown-todos.json",
        "scopeName": "markdown-todos.checkbox",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "markup.taskList.checked.markdown",
            "settings": {
              "foreground": "#4CAF50",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "markup.taskList.unchecked.markdown",
            "settings": {
              "foreground": "#F44336",
              "fontStyle": "bold"
            }
          }
        ]
      }
    },
    "commands": [
      {
        "command": "markdown-todos.focus",
        "title": "Markdown To-Do: Focus"
      },
      {
        "command": "markdown-todos.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "markdown-todos.toggleTicked",
        "title": "Toggle ✓ display",
        "icon": "$(filter)"
      },
      {
        "command": "markdown-todos.openInApplication",
        "title": "Open in external application"
      },
      {
        "command": "markdown-todos.openWithApplication",
        "title": "Open in external application..."
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markdown-todos",
          "title": "MarkDown To-Do",
          "icon": "icons/icon.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "markdown-todos-explorer",
          "name": "MarkDown To-Dos"
        }
      ],
      "markdown-todos": [
        {
          "id": "markdown-todos-view-container",
          "name": "MarkDown To-Dos"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "group": "navigation",
          "command": "markdown-todos.toggleTicked",
          "when": "view == markdown-todos-view-container || view == markdown-todos-explorer"
        },
        {
          "group": "navigation",
          "command": "markdown-todos.refresh",
          "when": "view == markdown-todos-view-container || view == markdown-todos-explorer"
        }
      ],
      "explorer/context": [
        {
          "command": "markdown-todos.openInApplication",
          "group": "navigation"
        },
        {
          "command": "markdown-todos.openWithApplication",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "markdown-todos.openInApplication",
          "group": "0"
        },
        {
          "command": "markdown-todos.openWithApplication",
          "group": "1"
        }
      ],
      "view/item/context": [
        {
          "command": "markdown-todos.openInApplication",
          "group": "navigation",
          "when": "(view == markdown-todos-view-container || view == markdown-todos-explorer) && viewItem == file"
        },
        {
          "command": "markdown-todos.openWithApplication",
          "group": "navigation@1",
          "when": "(view == markdown-todos-view-container || view == markdown-todos-explorer) && viewItem == file"
        }
      ]
    },
    "configuration": [
      {
        "title": "markdown-todos",
        "properties": {
          "markdown-todos.openInApplication.applications": {
            "type": "object",
            "description": "Map file extensions to launcher command strings. Use %p for the parent folder, %f for the full file path, and * as the fallback.",
            "default": {},
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    ]
  },
  "repository": {
    "url": "https://github.com/dwu/vscode-markdown-todos.git"
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "test:unit": "npm run compile-tests && mocha --ui tdd out/test/cache.test.js out/test/indexing.test.js out/test/asyncQueue.test.js out/test/parser.test.js out/test/treeItems.test.js out/test/launcher.test.js",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.56.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
